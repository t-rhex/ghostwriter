<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ghostwriter.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Ghostwriter.app/Contents/MacOS/Ghostwriter</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/usr/local/share/ghostwriter</string>
    <key>StandardOutPath</key>
    <string>/tmp/ghostwriter.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ghostwriter.stderr.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
